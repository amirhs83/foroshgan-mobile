# --- Vercel production (Neon Postgres via Vercel Marketplace) ---
# Injected automatically by the Neon integration (see vercel env ls).
# Prisma uses the pooled connection + pgbouncer (required for serverless):
# PRISMA_DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?pgbouncer=true&connect_timeout=15&sslmode=require
AUTH_SECRET=generate-with-openssl-rand-hex-32

# --- Local dev (optional) ---
# Same Neon DB or a local postgres instance:
# PRISMA_DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# --- AI ---
# GEMINI_API_KEY=your-gemini-key
# AI_PROVIDER_DEFAULT=gemini
# CRON_SECRET=secret-for-/api/cron/cleanup
